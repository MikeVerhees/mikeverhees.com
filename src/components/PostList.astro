---
import type { CollectionEntry } from "astro:content";
import { isoDate, postUrl, readableDate } from "../lib/posts";

interface Props {
	posts: CollectionEntry<"blog">[];
	/** Number shown next to the first item; defaults to the list length. */
	startFrom?: number;
}

const { posts, startFrom = posts.length } = Astro.props;
---

<ol reversed class="postlist" style={`counter-reset: start-from ${startFrom + 1}`}>
	{
		posts.map((post) => (
			<li class="postlist-item">
				<a href={postUrl(post)} class="postlist-link">
					{post.data.title}
				</a>
				<time class="postlist-date" datetime={isoDate(post.data.date)}>
					{readableDate(post.data.date, "month")}
				</time>
			</li>
		))
	}
</ol>
