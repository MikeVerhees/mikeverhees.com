---
// Island: a tiny web component. Its script is bundled by Astro and only
// loaded on pages that render this component. Without JavaScript the button
// stays hidden and the site follows the system color scheme.
---

<theme-toggle>
	<button type="button" class="theme-toggle" hidden aria-pressed="false">
		<span class="visually-hidden">Dark theme</span>
		<span aria-hidden="true" class="theme-toggle-icon"></span>
	</button>
</theme-toggle>

<style>
	theme-toggle {
		margin-left: auto;
	}
	.theme-toggle {
		background: none;
		border: 1px solid var(--color-gray-20);
		border-radius: 999px;
		color: inherit;
		cursor: pointer;
		font: inherit;
		padding: 0.25em 0.6em;
	}
	.theme-toggle[aria-pressed="false"] .theme-toggle-icon::before {
		content: "☾";
	}
	.theme-toggle[aria-pressed="true"] .theme-toggle-icon::before {
		content: "☀";
	}
</style>

<script>
	import { ThemeToggle } from "../scripts/theme-toggle";

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
