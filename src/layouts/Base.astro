---
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.svelte";
import ThemeToggle from "../components/ThemeToggle.svelte";
import ContactLinks from "../components/ContactLinks.astro";
import { getPaletteItems } from "../lib/palette-items";
import { site } from "../site";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);
const paletteItems = await getPaletteItems();
---

<!doctype html>
<html lang={site.language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		<meta name="description" content={description ?? site.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title={site.title} />
		<link rel="alternate" href="/feed/feed.json" type="application/json" title={site.title} />
		<meta name="generator" content={Astro.generator} />
		{/* Apply a saved theme before first paint so there's no flash of the wrong theme. */}
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme");
				if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
	</head>
	<body>
		<a href="#skip" class="visually-hidden skip-link">Skip to main content</a>

		<div class="wrap">
			<header class="site-header">
				<a href="/" class="home-link" aria-current={currentPath === "/" ? "page" : undefined}>{site.handle}</a>
				<nav aria-label="Main">
					<ul class="site-nav">
						{
							site.nav.map((entry) => (
								<li>
									<a href={entry.url} aria-current={currentPath.startsWith(entry.url) ? "page" : undefined}>
										{entry.title}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<CommandPalette client:idle items={paletteItems} email={site.author.email} />
				<ThemeToggle client:load />
			</header>

			<main id="skip">
				<slot />
			</main>

			<footer class="site-footer">
				<span class="mono">© {new Date().getFullYear()} {site.author.name} · static HTML, built with Astro</span>
				<ContactLinks size={20} />
			</footer>
		</div>
	</body>
</html>
