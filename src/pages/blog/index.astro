---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/content";

const posts = await getPosts();
---

<Base title="Archive">
	<h1>Archive</h1>
	{posts.length > 0 ? <PostList posts={posts} /> : <p>No posts yet.</p>}
</Base>
