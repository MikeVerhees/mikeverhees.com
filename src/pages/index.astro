---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { Content as About } from "../partials/about.md";
import { getPosts } from "../lib/content";

const LATEST = 3;
const posts = await getPosts();
const latest = posts.slice(0, LATEST);
const more = posts.length - latest.length;
---

<Base>
	<About />

	{
		latest.length > 0 && (
			<>
				<h1>
					Latest {latest.length} Post{latest.length !== 1 && "s"}
				</h1>
				<PostList posts={latest} startFrom={posts.length} />
			</>
		)
	}
	{
		more > 0 && (
			<p>
				{more} more post{more !== 1 && "s"} can be found in <a href="/blog/">the archive</a>.
			</p>
		)
	}
</Base>
